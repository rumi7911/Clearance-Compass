# Copy to .env (or export directly) before running locally.

# Google Cloud project with the Vertex AI API enabled — this is what makes
# the Gemini calls "Gemini Enterprise" rather than a consumer AI Studio key.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# From https://parallel.ai — free tier covers this project.
PARALLEL_API_KEY=your-parallel-api-key

# Optional override; defaults to gemini-2.5-flash.
# CLEARANCE_COMPASS_MODEL=gemini-2.5-flash

# From https://clickhouse.com/cloud — free tier covers this project. Used
# for the agent-memory layer (backend/data/memory.py): past live research
# verdicts get cached here so the pipeline doesn't re-research the same
# entity across runs. Optional -- if unset, this feature silently no-ops
# and the pipeline behaves exactly as it did before (every entity is
# freshly researched every time).
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=default
